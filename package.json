{
  "name": "recipe-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/docker-compose.cjs up --build --force-recreate --renew-anon-volumes",
    "dev:local": "concurrently -k -n web,api \"npm run dev --workspace @recipe-app/web\" \"npm run start:dev --workspace @recipe-app/api\"",
    "build": "npm run build --workspace @recipe-app/web && npm run build --workspace @recipe-app/api",
    "dev:web": "npm run dev --workspace @recipe-app/web",
    "dev:api": "npm run start:dev --workspace @recipe-app/api",
    "docker:up": "node scripts/docker-compose.cjs up --build --force-recreate --renew-anon-volumes -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow --tail=100",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
